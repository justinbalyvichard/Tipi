  "canaux": [
    "tts",
    "affiche",
    "les_deux"
  ],
  "jetons_connus": {
    "{n}": "Nombre de pierres. Inventaire, jamais un score (PED-07, ETH-04)."
  },
  "regles": {
    "perimetre": "Textes FIXES de l'interface : titres, libellés de bouton, étiquettes, états vides, messages d'état. Un texte qui varie d'un soir à l'autre n'a rien à faire ici : il vit dans content/encouragements.json. Les rituels vivent dans content/gwenn-scripts.json.",
    "propriete_des_cles": "Une clé d'écran a exactement un fichier propriétaire, celui qui porte son texte. La liste cles_fixes_non_variees de encouragements.json ne porte aucun texte : elle déclare seulement ce que la banque ne fait pas varier.",
    "source": "docs/agents/P1/produit-marketing.out.md. Les textes sont extraits de ses tables, jamais ressaisis.",
    "role": "Règle mécanique, aucun rôle deviné : un dernier segment commençant par « bouton » donne bouton ; un verbe d'action de la liste publiée donne action ; « titre » donne titre ; un segment finissant par « aide » donne aide ; un segment commençant par « corps » donne corps ; un texte réduit à un jeton donne valeur ; tout le reste donne indetermine. La valeur de repli s'appelle indetermine et non texte, pour qu'un composant ne la rende pas en corps de texte par défaut.",
    "condition": "null quand le texte s'affiche dans le cas nominal de son écran. Sinon, la condition d'affichage en clair. Le champ condition_source dit d'où elle vient : intertitre (reprise mot pour mot de l'intertitre du livrable marketing), segment_de_cle (mise en phrase de l'état que la clé nomme elle-même, table publiée ci-dessous), ou definie_ici (les neuf observations du résumé parent, créées par ce livrable).",
    "conditions_par_segment": [
      {
        "segment": "camera_refusee",
        "condition": "l'accès à l'appareil photo est refusé"
      },
      {
        "segment": "envoi_echec",
        "condition": "l'envoi de la photo a échoué"
      },
      {
        "segment": "analyse_echec",
        "condition": "l'analyse des photos n'a pas abouti"
      },
      {
        "segment": "lancement_echec",
        "condition": "le lancement de la session a échoué"
      },
      {
        "segment": "illisible",
        "condition": "l'OCR n'a rien pu lire sur la photo"
      },
      {
        "segment": "audio_absent",
        "condition": "l'enregistrement audio a été purgé"
      },
      {
        "segment": "session_expiree",
        "condition": "la session Réglages a expiré"
      },
      {
        "segment": "discordance",
        "condition": "les deux saisies du code ne correspondent pas"
      },
      {
        "segment": "refuse_reste",
        "condition": "le code saisi ne correspond pas, et des essais restent"
      },
      {
        "segment": "refuse",
        "condition": "le code saisi ne correspond pas"
      },
      {
        "segment": "bloque",
        "condition": "la saisie est bloquée après cinq essais (SEC-02)"
      },
      {
        "segment": "creation.avert",
        "condition": "à la création du code parent"
      },
      {
        "segment": "paliers.atteint",
        "condition": "le palier a été atteint"
      },
      {
        "segment": "paliers.vide",
        "condition": "aucun palier n'est défini"
      },
      {
        "segment": "vide.paliers",
        "condition": "aucun palier n'est défini"
      },
      {
        "segment": "vide.audio",
        "condition": "aucun enregistrement n'est conservé"
      },
      {
        "segment": "vide.calibration",
        "condition": "aucune analyse n'est journalisée"
      },
      {
        "segment": "echec.sauvegarde",
        "condition": "l'enregistrement du réglage a échoué"
      },
      {
        "segment": "echec.export",
        "condition": "la préparation de l'export a échoué"
      },
      {
        "segment": "echec.suppression",
        "condition": "la suppression n'a pas abouti"
      },
      {
        "segment": "sans_devoir",
        "condition": "la soirée s'est déroulée sans aucun devoir"
      },
      {
        "segment": "apercu.echec",
        "condition": "la préparation du programme a échoué"
      }
    ],
    "exclusif_avec": "Clés qui décrivent le même emplacement d'écran et ne peuvent pas s'afficher ensemble. Une clé sœur peut vivre dans un autre fichier de content/ : enfant.programme.titre est porté par la banque encouragements.json.",
    "jetons": "Substitués au rendu. {prenom} vient de child.prenom (PRD-02), jamais écrit en dur. {n} et {date} sont des valeurs de session.",
    "canal": "Repris tel quel du livrable marketing. Toute information utile à l'action est en les_deux : elle est doublée à l'oral (PED-10).",
    "charge": "Une idée par phrase, 12 mots maximum par phrase, vocabulaire de CE1, comme toute parole adressée à l'enfant."
  },
