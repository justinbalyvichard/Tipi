            {
              "id": "bienvenue.3.corps_2",
              "ordre": 3,
              "role": "corps",
              "texte": "Tu gagnes des pierres. Elles restent à toi.",
              "canal": "les_deux",
              "condition": null,
              "jetons": []
            },
            {
              "id": "bienvenue.3.bouton",
              "ordre": 4,
              "role": "bouton",
              "texte": "On y va",
              "canal": "affiche",
              "condition": null,
              "jetons": []
            }
          ]
        }
      ]
