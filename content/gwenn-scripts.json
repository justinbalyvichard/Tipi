            {
              "id": "bienvenue.1.bouton",
              "ordre": 3,
              "role": "bouton",
              "texte": "Bonjour Pilou",
              "canal": "affiche",
              "condition": null,
              "jetons": []
            }
          ]
        },
        {
          "id": "bienvenue_2",
          "ordre": 2,
          "libelle": "Ce qu'on fait ensemble",
