              "ordre": 1,
              "role": "titre",
              "texte": "On fait les devoirs ensemble.",
              "canal": "les_deux",
              "condition": null,
              "jetons": []
            },
            {
              "id": "bienvenue.2.corps",
              "ordre": 2,
              "role": "corps",
              "texte": "Deux choses par soir. Pas plus.",
              "canal": "les_deux",
              "condition": null,
              "jetons": []
            },
            {
              "id": "bienvenue.2.bouton",
              "ordre": 3,
              "role": "bouton",
              "texte": "D'accord",
              "canal": "affiche",
              "condition": null,
              "jetons": []
            }
          ]
        },
        {
          "id": "bienvenue_3",
          "ordre": 3,
          "libelle": "La pause et les pierres",
          "lignes": [
            {
              "id": "bienvenue.3.titre",
              "ordre": 1,
              "role": "titre",
              "texte": "Tu peux t'arrêter quand tu veux.",
              "canal": "les_deux",
              "condition": null,
              "jetons": []
            },
            {
              "id": "bienvenue.3.corps",
              "ordre": 2,
              "role": "corps",
              "texte": "Appuie sur la pause. Je t'attends.",
              "canal": "les_deux",
              "condition": null,
              "jetons": []
