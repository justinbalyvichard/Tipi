{
  "schema": "tipi.gwenn-scripts.v1",
  "version": "1.0.0",
  "personnage": "Pilou",
  "note_nom_de_fichier": "Le fichier s'appelle gwenn-scripts.json parce que le prompt maître le nomme ainsi. Le personnage s'appelle Pilou partout dans les textes.",
