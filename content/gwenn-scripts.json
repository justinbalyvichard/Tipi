            {
              "id": "bravo.pierres_plus_tard",
              "ordre": 5,
              "role": "corps",
              "texte": "Je range tes pierres un peu plus tard.",
              "canal": "les_deux",
              "condition": "credit_pierres_differe",
              "jetons": []
            },
            {
              "id": "bravo.pierres_plus_tard_2",
              "ordre": 6,
              "role": "corps",
              "texte": "Elles sont à toi. Elles ne se perdent pas.",
              "canal": "les_deux",
              "condition": "credit_pierres_differe",
              "jetons": []
