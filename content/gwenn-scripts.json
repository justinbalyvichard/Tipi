  "canaux": [
    "tts",
    "affiche",
    "les_deux"
  ],
  "regles": {
    "fixite": "Ces répliques n'ont aucune variante. Elles sont jouées telles quelles, dans l'ordre du champ ordre.",
    "lecture_tts": "Pilou lit, dans l'ordre, toutes les lignes dont le canal vaut tts ou les_deux et dont la condition est remplie.",
    "condition": "null signifie toujours jouée. Une chaîne nomme l'état applicatif qui déclenche ou remplace la ligne."
  },
  "rituels": {
    "onboarding": {
      "id": "onboarding",
      "libelle": "Onboarding en 3 écrans",
      "route": "/bienvenue",
