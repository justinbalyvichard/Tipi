            {
              "id": "bravo.pierres",
              "ordre": 3,
              "role": "corps",
              "texte": "Tu as gagné des pierres.",
              "canal": "les_deux",
              "condition": "credit_pierres_ok",
              "jetons": []
            },
            {
              "id": "bravo.coffre",
              "ordre": 4,
              "role": "corps",
              "texte": "Je les range dans ton coffre.",
              "canal": "les_deux",
              "condition": "credit_pierres_ok",
              "jetons": []
