            {
              "id": "bravo.fin",
              "ordre": 7,
              "role": "corps",
              "texte": "C'est fini. Tu peux aller jouer.",
              "canal": "les_deux",
              "condition": null,
              "jetons": []
            },
            {
              "id": "bravo.bouton",
              "ordre": 8,
              "role": "bouton",
              "texte": "Voir mon coffre",
              "canal": "affiche",
              "condition": null,
              "jetons": []
            },
            {
              "id": "bravo.bouton_2",
              "ordre": 9,
              "role": "bouton",
              "texte": "Aller jouer",
              "canal": "affiche",
              "condition": null,
              "jetons": []
            }
          ]
