# =============================================================================
# Tipi — variables d'environnement (modèle)
# =============================================================================
# Copier en `.env.local` et remplir. AUCUNE VALEUR RÉELLE ICI : ce fichier est
# versionné. Les valeurs ci-dessous sont des exemples inoffensifs.
#
# Règle TEC-13, sans exception : une variable préfixée NEXT_PUBLIC_ est inlinée
# dans le bundle client par Next.js. Aucune clé d'API n'en porte le préfixe.
# Les trois seules variables publiques de Tipi sont sans valeur secrète.
#
# Validation : `src/config/env.ts` parse ces variables avec Zod au démarrage du
# serveur. Une variable obligatoire manquante fait ÉCHOUER LE DÉMARRAGE avec un
# message nommant la variable — jamais une panne silencieuse en pleine soirée.
# Le détail « ce qui se passe si elle manque » est dans
# docs/agents/P2/architecture.out.md, section 11.
# =============================================================================


# --- Base de données (TEC-02, TEC-03) ----------------------------------------
# Serveur uniquement. Obligatoires : sans elles, rien ne démarre.
# DATABASE_URL passe par le pooler Supabase (port 6543), DIRECT_URL par la
# connexion directe (port 5432), utilisée par prisma migrate.
DATABASE_URL="postgresql://postgres.exemple:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.exemple:motdepasse@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"


# --- Supabase Storage (TEC-02) -----------------------------------------------
# Serveur uniquement. SUPABASE_SERVICE_ROLE_KEY donne un accès total au projet :
# elle ne doit apparaître dans aucun composant, aucun hook, aucun fichier
# importé par le client.
SUPABASE_URL="https://exemple.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="remplacer-par-la-cle-service-role"

# URL publique du bucket de cache TTS (TEC-09b). Publique par construction :
# c'est une URL de fichiers audio, pas une clé. Sert au client pour jouer un
# clip déjà synthétisé sans passer par le serveur.
# Ce bucket ne contient QUE des clips sans donnée identifiante. Les clips qui
# prononcent le prénom de l'enfant vivent dans le bucket privé `tts-prive` et
# ne sont servis que par URL signée (SEC-04).
NEXT_PUBLIC_TTS_CACHE_URL="https://exemple.supabase.co/storage/v1/object/public/tts-cache"

# Tailles maximales de téléversement, en octets. Serveur.
# SEULE duplication assumée du livrable : ces deux valeurs sont AUSSI écrites
# dans supabase/policies.sql (file_size_limit des buckets `devoirs` et
# `audios`), parce que Storage ne peut pas lire le code applicatif. Les deux
# côtés doivent rester égaux, sinon un fichier accepté par la route serait
# rejeté silencieusement par Storage. La vérification V7 de policies.sql les
# affiche pour comparaison.
UPLOAD_MAX_PHOTO_OCTETS="8388608"
UPLOAD_MAX_AUDIO_OCTETS="10485760"


# --- Fournisseur d'IA (TEC-05, TEC-17) ---------------------------------------
# Serveur uniquement. AI_PROVIDER est le point de bascule de TEC-17 : changer de
# fournisseur est un changement de valeur ici, plus une implémentation dans
# src/lib/ai/providers/. Aucun autre fichier ne connaît le nom « deepseek ».
AI_PROVIDER="deepseek"
DEEPSEEK_API_KEY="remplacer-par-la-cle-deepseek"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
# Délai au-delà duquel l'appel est abandonné et l'état PRD-16 « analyse
# impossible » est rendu, avec saisie manuelle proposée.
AI_TIMEOUT_MS="20000"


# --- Google Cloud : OCR (TEC-05) et voix de Pilou (TEC-08) -------------------
# Serveur uniquement. Le JSON du compte de service, sur une seule ligne.
# Un seul compte de service porte Vision et Text-to-Speech.
GOOGLE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"exemple","private_key_id":"000","private_key":"-----BEGIN PRIVATE KEY-----\nREMPLACER\n-----END PRIVATE KEY-----\n","client_email":"tipi@exemple.iam.gserviceaccount.com","client_id":"000"}'

# Fournisseur de synthèse vocale (TEC-08). Interchangeable derrière
# VoiceProvider. Le NOM DE LA VOIX n'est pas ici : il est figé pour toujours
# dans src/config/mascot.config.ts, par décision humaine (section 8.5 du
# prompt maître). Une voix qui changerait par variable d'environnement serait
# une rupture pour l'enfant.
VOICE_PROVIDER="google-chirp3"

# Fournisseur de reconnaissance vocale (TEC-09). Public : le choix se fait dans
# le navigateur, et ce n'est pas un secret. `web-speech` = Web Speech API,
# gratuite et sans quota. `google` bascule sur la route serveur de repli, qui
# n'est implémentée que si le test avec la voix d'Evan l'exige.
NEXT_PUBLIC_SPEECH_PROVIDER="web-speech"


# --- Code parent et accès Réglages (PRD-15, SEC-01, SEC-02) ------------------
# Serveur uniquement. Secret de signature du cookie de session Réglages.
# 32 octets aléatoires : `openssl rand -base64 32`.
# LE CODE PARENT LUI-MÊME N'EST JAMAIS ICI (section 8.2 du prompt maître) :
# il est choisi par un humain dans l'application et stocké en hash argon2id.
PARENT_SESSION_SECRET="remplacer-par-32-octets-aleatoires-en-base64"
# Durée d'inactivité avant fermeture automatique des Réglages.
PARENT_SESSION_TTL_MIN="5"
# SEC-02 — blocage progressif.
CODE_MAX_TENTATIVES="5"
CODE_BLOCAGE_PALIERS_SEC="60,300,900,3600"


# --- Seuils de calibration (TEC-16) ------------------------------------------
# Serveur. Ces seuils ne se règlent que sur de vraies photos : ils sont ici, et
# nulle part ailleurs dans le code. Aucune constante dispersée.
# Confiance OCR minimale en dessous de laquelle la photo est « illisible ».
OCR_CONFIANCE_MIN="0.70"
# Tolérance du matching de lecture : distance de Levenshtein maximale par mot,
# rapportée à la longueur du mot (0.34 = un caractère sur trois).
LECTURE_TOLERANCE_MOT="0.34"
# Part de mots reconnus à partir de laquelle la lecture est considérée faite.
# Jamais affichée à l'enfant, jamais un score (PED-07).
LECTURE_SEUIL_MOTS_OK="0.60"
# PED-08 — nombre de sollicitations sans réponse exploitable avant que Pilou
# propose une pause ou de passer à autre chose.
BLOCAGE_NB_SOLLICITATIONS="3"
# TEC-16 — nombre de photos journalisées en mode calibration.
CALIBRATION_NB_PHOTOS="20"


# --- Rétention des audios (SEC-05) -------------------------------------------
# Serveur. Valeur par défaut à la création du foyer. La valeur qui fait foi
# ensuite est family.retention_audio_jours, réglable dans Réglages.
AUDIO_RETENTION_JOURS_DEFAUT="7"
# Secret du déclencheur de purge planifiée (Vercel Cron). Sans lui, la route de
# purge refuse tout appel.
CRON_SECRET="remplacer-par-32-octets-aleatoires"


# --- Divers ------------------------------------------------------------------
# Public. Affiché dans Réglages > À propos. Aucune valeur sensible.
NEXT_PUBLIC_APP_VERSION="0.1.0"
